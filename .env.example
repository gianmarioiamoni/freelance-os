# FreelanceOS environment template
#
# Copy this file to `.env` in the project root.
# Prisma reads `DATABASE_URL` from `.env`.
# Do not put real credentials in this file.
# Do not commit `.env`.
# Do not expose these values to the browser (`NEXT_PUBLIC_` is forbidden).
#
# Classification (names only; do not invent hosted URLs, credentials, or API keys)
#
# Required production (set on Vercel; values are external):
#   DATABASE_URL
#   BETTER_AUTH_SECRET
#   BETTER_AUTH_URL
#   GOOGLE_CLIENT_ID
#   GOOGLE_CLIENT_SECRET
#   SMTP_HOST
#   SMTP_PORT
#   SMTP_SECURE
#   SMTP_USER
#   SMTP_PASSWORD
#
# Optional (all environments):
#   AUTH_EMAIL_DELIVERY
#   Unset in production → production mode when NODE_ENV=production.
#
# Local / test (never set on Vercel):
#   TEST_DATABASE_URL
#
# E2E-only (never set on Vercel):
#   AUTH_E2E_RUNTIME
#
# Secrets — never commit real values:
#   DATABASE_URL credentials, BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET,
#   SMTP_PASSWORD. Do not commit production GOOGLE_CLIENT_ID or SMTP_USER.

# Server-only PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/freelance_os?schema=public"

# Isolated integration and Playwright E2E database. Never point this at freelance_os.
# Local example: postgresql://USER:PASSWORD@localhost:5432/freelanceos_test?schema=public
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/freelanceos_test?schema=public"

# Better Auth 1.7.4 server-only secret. At least 32 characters.
# Generate with: openssl rand -base64 32
# Never use NEXT_PUBLIC_ for this value.
BETTER_AUTH_SECRET=""

# Application base URL used by Better Auth for callbacks and cookies.
# Production: the Vercel deployment origin. Do not invent a hostname in this file.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Better Auth). Server-only. Optional in development and test/CI.
# Required in production: Google sign-in remains in the MVP release.
# Authorized redirect URI uses BETTER_AUTH_URL:
#   ${BETTER_AUTH_URL}/api/auth/callback/google
# Local example: http://localhost:3000/api/auth/callback/google
# Production: use the Vercel origin once it exists; do not invent a hostname here.
# Never use NEXT_PUBLIC_ for these values. Do not commit real credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Password-reset email delivery mode. Server-only.
# development — acknowledges delivery locally; never logs tokens or reset URLs
# test — captures messages in a process-local store for automated tests
# production — sends through Gmail SMTP when SMTP_HOST, SMTP_PORT, SMTP_SECURE,
# SMTP_USER, and SMTP_PASSWORD are set
# If unset: NODE_ENV=test → test, NODE_ENV=production → production, otherwise development
AUTH_EMAIL_DELIVERY=""

# Gmail SMTP (production password-reset mailer). Server-only.
# Required in production to complete password recovery.
# Never use NEXT_PUBLIC_ for these values. Do not commit real credentials.
SMTP_HOST=""
SMTP_PORT=""
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""

# E2E-only. Playwright injects AUTH_E2E_RUNTIME=true when starting `pnpm start`.
# Isolates Better Auth rate limits for the E2E process. Never set on Vercel.
AUTH_E2E_RUNTIME=""
