// prisma/schema.prisma
// Application-owned models are from EPIC-002. CHECK, exclusion, and
// composite workspace FKs that Prisma cannot express remain in the
// EPIC-002 SQL migrations.
// Better Auth 1.7.4 owns User, Session, Account, and Verification.
// WorkspaceMember.userId is a logical Better Auth user id, not a Prisma FK.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceMemberRole {
  OWNER
  MEMBER
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum BillingModel {
  HOURLY
  DAILY
}

enum AlertType {
  CONTRACT_WARNING
  CONTRACT_EXCEEDED
  CAPACITY_WARNING
  CAPACITY_EXCEEDED
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  timezone  String
  currency  String   @db.Char(3)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  members       WorkspaceMember[]
  settings      WorkspaceSettings?
  clients       Client[]
  contracts     Contract[]
  timeEntries   TimeEntry[]
  invoices      Invoice[]
  alerts        Alert[]
  notifications Notification[]
}

model WorkspaceMember {
  workspaceId String              @db.Uuid
  /// Logical Better Auth User.id. No Prisma FK by design.
  userId      String
  role        WorkspaceMemberRole
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  timeEntries   TimeEntry[]
  notifications Notification[]

  @@id([workspaceId, userId])
  @@index([userId])
}

model Client {
  id          String       @id @default(uuid()) @db.Uuid
  workspaceId String       @db.Uuid
  companyName String
  vatNumber   String?
  taxCode     String?
  address     String?      @db.Text
  contactName String?
  email       String?
  phone       String?
  notes       String?      @db.Text
  status      ClientStatus
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  contracts   Contract[]
  timeEntries TimeEntry[]
  alerts      Alert[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@index([workspaceId, companyName])
}

model Contract {
  id                       String       @id @default(uuid()) @db.Uuid
  workspaceId              String       @db.Uuid
  clientId                 String       @db.Uuid
  validFrom                DateTime     @db.Date
  validTo                  DateTime?    @db.Date
  billingModel             BillingModel
  /// Positive monetary rate. CHECK (rate > 0) is enforced in SQL.
  rate                     Decimal      @db.Decimal(19, 4)
  currency                 String       @db.Char(3)
  monthlyContractedMinutes Int?
  paymentTermsDays         Int?
  paymentTermsNote         String?      @db.Text
  createdAt                DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime     @updatedAt @db.Timestamptz(6)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  client      Client      @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Restrict)
  timeEntries TimeEntry[]
  invoices    Invoice[]
  alerts      Alert[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, clientId, id])
  @@index([workspaceId, clientId, validFrom])
  @@index([workspaceId, clientId, validTo])
}

model Invoice {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @db.Uuid
  contractId       String    @db.Uuid
  invoiceDate      DateTime  @db.Date
  /// Positive monetary amount. CHECK (amount > 0) is enforced in SQL.
  amount           Decimal   @db.Decimal(19, 4)
  /// ISO 4217 snapshot of Contract.currency at write. Immutable after create.
  currency         String    @db.Char(3)
  reference        String?   @db.Text
  /// Snapshot of Contract.paymentTermsDays at write. Null iff dueDate is null.
  paymentTermsDays Int?
  dueDate          DateTime? @db.Date
  /// Null = ACTIVE. Set = VOID. One-way soft-delete.
  voidedAt         DateTime? @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  contract  Contract  @relation(fields: [workspaceId, contractId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, id])
  @@index([workspaceId, contractId, invoiceDate])
  @@index([workspaceId, voidedAt])
}

model TimeEntry {
  id              String   @id @default(uuid()) @db.Uuid
  workspaceId     String   @db.Uuid
  userId          String
  clientId        String   @db.Uuid
  contractId      String   @db.Uuid
  workDate        DateTime @db.Date
  /// Positive duration. CHECK (durationMinutes > 0) is enforced in SQL.
  durationMinutes Int
  description     String?  @db.Text
  billable        Boolean
  /// Commercial value applicable when the work was recorded (R2-OD-003).
  snapshotBillingModel BillingModel
  /// Positive monetary rate snapshot. CHECK (snapshotRate > 0) is enforced in SQL.
  snapshotRate         Decimal      @db.Decimal(19, 4)
  snapshotCurrency     String       @db.Char(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  member    WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict)
  client    Client          @relation(fields: [workspaceId, clientId], references: [workspaceId, id], onDelete: Restrict)
  contract  Contract        @relation(fields: [workspaceId, clientId, contractId], references: [workspaceId, clientId, id], onDelete: Restrict)

  @@index([workspaceId, workDate])
  @@index([workspaceId, clientId, workDate])
  @@index([workspaceId, contractId, workDate])
  @@index([workspaceId, userId, workDate])
}

model WorkspaceSettings {
  workspaceId                   String   @id @db.Uuid
  timezone                      String
  currency                      String   @db.Char(3)
  /// 0 < value <= 100. CHECK is enforced in SQL.
  contractWarningPercent        Int
  /// 0 < value <= 100. CHECK is enforced in SQL.
  monthlyCapacityWarningPercent Int
  createdAt                     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
}

model Alert {
  id               String        @id @default(uuid()) @db.Uuid
  workspaceId      String        @db.Uuid
  type             AlertType
  severity         AlertSeverity
  clientId         String?       @db.Uuid
  contractId       String?       @db.Uuid
  periodStart      DateTime?     @db.Date
  periodEnd        DateTime?     @db.Date
  deduplicationKey String
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  resolvedAt       DateTime?     @db.Timestamptz(6)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contract      Contract?      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, deduplicationKey])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, resolvedAt])
  @@index([workspaceId, type])
}

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String
  alertId     String?   @db.Uuid
  type        String
  title       String
  body        String    @db.Text
  readAt      DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  member    WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict)
  alert     Alert?          @relation(fields: [alertId], references: [id], onDelete: Restrict)

  @@index([workspaceId, userId, createdAt])
  @@index([workspaceId, userId, readAt])
}

// Better Auth-owned persistence. Generated by `auth@1.7.4 generate`.
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
